{
    "$schema": "https://typedoc-plugin-markdown.org/schema.json",
    "entryPointStrategy": "expand",
    "entryPoints": [
        "../../src/plugin.ts"
    ],
    "exclude": [
        "**/dist/**",
        "**/node_modules/**",
        "**/coverage/**",
        "**/build/**"
    ],
    "excludeInternal": true,
    "hideGenerator": true,
    "out": "./site-docs/api",
    "plugin": [
        "typedoc-plugin-markdown"
    ],
    "readme": "none",
    "tsconfig": "../../tsconfig.json"
}
