{
    "$schema": "https://typedoc.org/schema.json",
    "entryPointStrategy": "expand",
    "entryPoints": [
        "../../src/plugin.ts",
        "../../src/_internal",
        "../../src/rules"
    ],
    "exclude": [
        "**/coverage/**",
        "**/dist/**",
        "**/node_modules/**"
    ],
    "excludePrivate": true,
    "excludeProtected": true,
    "includeVersion": false,
    "out": "site-docs/developer/api",
    "plugin": [
        "typedoc-plugin-markdown"
    ],
    "readme": "none",
    "tsconfig": "../../tsconfig.json"
}
